{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true
  },
  "include": ["packages", "apps", "tools", "deploy"]
}
